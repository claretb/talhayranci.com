---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../images/gallery/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
const images = Object.entries(modules).sort(([a], [b]) => b.localeCompare(a));
---

<BaseLayout
  title="Aesthetics"
  description="A small visual journal of places and moments photographed by Talha Enes Ayranci."
>
  <section class="page-intro compact">
    <p class="eyebrow">Aesthetics</p>
    <h1>A small visual journal.</h1>
    <p>Places, details and moments that caught my attention.</p>
  </section>
  <div class="gallery">
    {images.map(([, module], index) => (
      <a
        href={module.default.src}
        target="_blank"
        aria-label={`Open photograph ${index + 1}`}
      >
        <Image
          src={module.default}
          alt={`Photograph from Talha's visual journal, ${index + 1}`}
          widths={[360, 720]}
          sizes="(max-width: 720px) 100vw, 33vw"
          loading={index < 3 ? 'eager' : 'lazy'}
        />
      </a>
    ))}
  </div>
</BaseLayout>

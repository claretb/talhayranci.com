---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { site } from '../data/site';
import socialImage from '../images/profile.jpeg';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = site.description,
  image = socialImage.src,
  type = 'website',
} = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonicalURL = new URL(Astro.url.pathname, site.url);
const imageURL = new URL(image, site.url);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  sameAs: [site.social.github, site.social.linkedin, site.social.x],
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Glasgow',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} RSS`}
      href="/rss.xml"
    />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@talhayranci" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    ></script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <div class="site-shell">
      <Header />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
